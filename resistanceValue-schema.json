  "schema": {
    "oneOf": [
      {
        "type": "string",
        "pattern": "^([0-9]+(.[0-9]+)?)(m|k|M)?(ohms|Ω|Ω)$"
      },
      {
        "type": "object",
        "properties": {
          "value": {"type": "number"},
          "units": {
            "type": "string",
