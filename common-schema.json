{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": [
    "IDMVersion",
    "1.2 2025-08-10",
    "license (c) EMerge Alliance 2025, Licensed CC BY-NC-ND 4.0 -All Rights Reserved",
    "This is the JSON schema for all IDM products.  Listed below are all the parameters that are common to all types of product",
    "Particular types of product have their own schemas defined in separate files, which must be in the same folder, or sub-folders.",
    
    "fileVersion: 1.01","fileDate 2025-09-26"
  ],
  "type": "object",
  "properties": {
    "productIdentifier": { "$ref": "productIdentifier-schema.json#/schema" },
    "typeSpecificParameters": { "$ref": "typeSpecifics-schema.json#/schema" },
    "manufacturer": { "icon": "building", "$ref": "manufacturer-schema.json#/schema" },
    "environmental": { "icon": "cloud-sun", "$ref": "environmental-schema.json#/schema" },
    "productName": { "$ref": "productName-schema.json#/schema" },
    "description": {
      "title":"Product description",
      "type": "string",
      "description":"This is for a free-text description of the product. It should consist only of text, but may be up to 64kbytes long.",
      "format": "textarea",
      "minLength": 0,
      "maxLength": 65535
    },
    "listPriceUSD": { "type": "number" },
    "productWarrantyYrs": { "title": "Product Warranty (Years)", "type": "number" },
    "productSeries": { "icon": "boxes-stacked", "$ref": "productSeries-schema.json#/schema" },
    "datasheetHyperlink": {
      "type": "string",
      "description":"This should hyperlink to a web page or PDf that is specific to this product.  (If there isn't one, leave blank.)",
      "format": "uri"
    },
    "distributors": { "icon": "truck", "$ref": "distributors-schema.json#/schema" },
    "systemsIntegrators": { "icon": "handshake", "$ref": "distributors-schema.json#/schema" },
    "embargoedCountries": { "icon": "ban", "$ref": "embargoedCountries-schema.json#/schema" },
    "listingAuthorities": { "icon": "certificate", "$ref": "listingAuthorities-schema.json#/schema" },
    "files": { "icon": "folder-open", "$ref": "files-schema.json#/schema" },
    "images": { "icon": "images", "$ref": "images-schema.json#/schema" },
    "notRecommendedForNewDesigns": { "type": "boolean" },
    "IDMVersion": { "const": "1.2 2025-08-10" },
    "license": { "const": "(c) EMerge Alliance 2025, Licensed CC BY-NC-ND 4.0 -All Rights Reserved" },
    "fileVersion":{"type":"string", "default":"0.0"},
    "fileDate":{"type":"string", "format": "date"},
    "changeRecord":{"icon": "clock-rotate-left", "$ref": "changeRecord-schema.json#/schema"}
  },
  "required": [
    "IDMVersion",
    "license",
    "manufacturer",
    "productIdentifier",
    "typeSpecificParameters"
  ],
  "selectionTool": {
    "$comment": "The selection tool will provide the filter, display and comparison sections with the values of those parameters listed in each of the referenced files",
    "filter": [
      "manufacturer.json",
      "productSeries.json",
      "notRecommendedForNewDesigns.json",
      "typeSpecificParameters.json",
      "environmental.json"
    ],
    "display": [
      "productIdentifier.json",
      "images.json",
      "typeSpecificParameters.json",
      "environmental.json",
      "files.json"
    ],
    "comparison": [
      "productIdentifier.json",
      "typeSpecificParameters.json",
      "environmental.json"
    ]
  }
}
