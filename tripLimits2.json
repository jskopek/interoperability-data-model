	"$comment": "Reasons that a breaker might turn off.",
	"title": "Breaker Trip Criteria",
	"description": "Types of protection offered by the breaker",
	"fileVersion": "1.2",
	"fileDate": "2026-06-05",
	"schema": {
		"type": "array",
		"items": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"criterion": { "const": "overCurrent" },
						"ratedCurrent": { "$ref": "currentRating-schema.json#/schema" }
					}
				},
				{
					"type": "object",
					"properties": {
						"criterion": { "const": "overVoltage" },
						"ratedCurrent": { "$ref": "voltageRating-schema.json#/schema" }
					}
				},
				{
					"type": "object",
					"properties": {
						"criterion": { "const": "underVoltage" },
						"ratedCurrent": { "$ref": "voltageRating-schema.json#/schema" }
					}
				},
				{
					"type": "object",
					"properties": {
						"criterion": { "const": "groundFault" },
						"ratedCurrent": { "$ref": "currentRating-schema.json#/schema" }
					}
				},
				{
					"type": "object",
					"properties": {
						"criterion": { "const": "phaseImbalance" },
						"neutralCurrent": { "$ref": "currentRating-schema.json#/schema" }
					}
				},
				{
					"type": "object",
					"properties": {
						"criterion": { "const": "frequencyDeviation" },
						"minFrequency": {
							"type": "string",
							"pattern": ""
						},
						"maxFrequency": {
							"type": "string",
							"pattern": ""
						}
					}
				},
				{
					"type": "object",
					"properties": {
						"criterion": { "const": "arcFault" }
					}
				},
				{
					"type": "object",
					"properties": {
						"criterion": { "const": "manualTrip" }
					}
				},
				{
					"type": "object",
					"properties": {
					  "criterion": { "const": "solenoid" },
					  "coilResistance": {"$ref": "resistanceValue-schema.json#/schema"},
					  "minDCVolts":{"title":"Recommended coil DC operating voltage",
						"$ref": "voltageRating-schema.json#/schema"},
					  "minACVolts":{"title":"Recommended coil AC operating voltage",
						"$ref": "voltageRating-schema.json#/schema"},
					  "coilContactIsolationVolts": {"$ref": "voltageRating-schema.json#/schema"}
					}
				}
			]
		}
	}
}
