{
  "IDMVersion": "1.2 2025-08-10",
  "license": "(c) EMerge Alliance 2025, Licensed CC BY-NC-ND 4.0 -All Rights Reserved",
  "$comment": "This JSON schema is for any electrical power port",
  "fileVersion": "1.1",
  "fileDate":"2026-02-12",  
  "schema": {
    "type": "object",
    "properties": {
      "portName": {"type": "string"},
      "frequency": {"$ref": "frequency-schema.json#/schema"},
      "connectionType": {"$ref": "phase-schema.json#/schema"},
      "SOA": {"$ref": "SOA-schema.json#/schema"},
      "VIrelationship": {
        "title":"V-I relationship",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "portType": {"const": "constantPower"},
              "powerLevel": {"$ref": "powerRating-schema.json#/schema"}
            }
          },
          {
            "type": "object",
            "properties": {
              "portType": {"const": "constantCurrent"},
              "currentLevel": {"$ref": "currentRating-schema.json#/schema"}
            }
          },
          {
            "type": "object",
            "properties": {
              "portType": {"const": "constantVoltage"},
              "openCctVolts": {"$ref": "voltageRating-schema.json#/schema"},
              "theveninResistance": {"$ref": "resistanceValue-schema.json#/schema"},
              "droopHysterisisVolts": {"$ref": "voltageRating-schema.json#/schema"}
            }
          },
          {
            "type": "object",
            "properties": {
              "portType": {"const": "constantResistance"},
              "resistanceValue": {"$ref": "resistanceValue-schema.json#/schema"}
            }
          },
          {
            "type": "object",
            "properties": {
              "portType": {"const": "batteryChargingPort"},
              "chargeCharacteristics": {"$ref": "batteryChargingPort-schema.json#/schema"}
            }
          },
          {
            "type": "object",
            "properties": {
              "portType": {"const": "VIrelationshipUndefined"}
            }
          }
        ]
      },
      "transferTime":{"$ref":"duration-schema.json#/schema"}, 
      "poleLocallyGrounded": {"$ref": "grounding-schema.json#/schema"},
      "groundWire": {"$ref": "PE-schema.json#/schema"},
      "connector": {"$ref": "connection-schema.json#/schema"},
      "prechargeProtection": {
        "description":"When a load is first powered up, any capacitance on the input has to charge extremely rapidly to the supply voltage.  This causes a large inrush current - only limited by the parasitic resistance in the system.  This current spike may damage connectors and switch contacts, and/or cause a momentary dip in the supply voltage experienced by other loads connected to the supply.  Some DC loads include a circuit to limit the initial precharge current, and some supplies require the load to have it.",
        "type": "string",
        "enum": [
          "provided",
          "required",
          "neither"
        ]
      },
      "crowbar": {"type": "boolean"}
    }
  }
}
