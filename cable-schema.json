  "fileVersion": "1.1",
  "fileDate":"2026-06-02",  
  "schema": {
    "type": "object",
    "properties": {
      "ratedVoltage":{"$ref":"voltageRating-schema.json#/schema"},
      "ratedCurrent":{"$ref":"currentRating-schema.json#/schema"},
      "resPerMeter":{"title":"Resistance per conductor per meter",
        "$ref":"restanceValue-schema.json#/schema"},
      "numberOfConductors": {
        "type": "integer",
        "minimum": 1
      },
      "length": {"$ref": "dimensions-schema.json#/schema"},
      "OD":{"title":"Outside diameter",
         "$ref": "dimensions-schema.json#/schema"
      },
      "minRad":{"title":"Minimum Bending Radius",
         "$ref": "dimensions-schema.json#/schema"
      },
      "conductorSize": {"$ref": "wireSizes-schema.json#/schema"},
      "strandsPerConductor": {
        "type": "integer",
        "minimum": 1
      },
      "conductorMaterial": {
        "type": "string",
        "enum": [
          "copper",
          "aluminum",
          "AAC",
          "AAAC",
          "ACSR"
        ]
      },
      "insulationMaterial": {"type": "string"},
      "armored": {"type": "boolean"}
    }
  }
}
