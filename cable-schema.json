{
  "IDMVersion": "1.2 2025-08-10",
  "icon": "plug",
  "license": "(c) EMerge Alliance 2025, Licensed CC BY-NC-ND 4.0 -All Rights Reserved",
  "fileVersion": "1.1",
  "fileDate":"2026-06-02",  
  "schema": {
    "type": "object",
    "properties": {
      "ratedVoltage":{"title":"Rated Voltage phase-to-phase (U)",
        "$ref":"voltageRating-schema.json#/schema"},
      "gndVoltage":{"title":"Rated Voltage phase-to-ground (Uo)",
        "$ref":"voltageRating-schema.json#/schema"},
      "ratedCurrent":{"title":"Rated current (buried)",
         "$ref":"currentRating-schema.json#/schema"},
      "ventedCurrent":{"title":"Rated current (free air)",
         "$ref":"currentRating-schema.json#/schema"},
      "resPerMeter":{"title":"Resistance per conductor per meter",
        "$ref":"resistanceValue-schema.json#/schema"},
      "numberOfConductors": {
        "type": "integer",
        "minimum": 1
      },
      "length": {"$ref": "dimensions-schema.json#/schema"},
      "OD":{"title":"Outside diameter",
         "$ref": "dimensions-schema.json#/schema"
      },
      "minRad":{"title":"Minimum Bending Radius",
         "$ref": "dimensions-schema.json#/schema"
      },
      "conductorSize": {"$ref": "wireSizes-schema.json#/schema"},
      "strandsPerConductor": {
        "type": "integer",
        "minimum": 1
      },
      "conductorMaterial": {
        "type": "string",
        "enum": [
          "copper",
          "aluminum",
          "AAC",
          "AAAC",
          "ACSR"
        ]
      },
      "fumingCharacteristic": {"$ref": "fumes-schema.json#/schema"},
      "sheathColor":{"type":"string"},
      "coreColors":{"type":"string"},
      "armored": {"type": "boolean"},
      "doubleInsulated": {"type": "boolean"},
      "weightPerLength": {
        "type": "object",
        "properties": {
          "value": {"type": "number"},
          "units": {
            "type": "string",
            "enum": [
              "g/m",
              "kg/km",
              "lbs/mi"
            ]
          }
        }
      },
      "conA":{"title":"Connector - A-end",
      "$ref":"connection-schema.json#/schema"},
      "conB":{"title":"Connector - B-end",
      "$ref":"connection-schema.json#/schema"}
    }
  }
}
