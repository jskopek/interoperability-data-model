{
  "IDMVersion": "1.2 2025-08-10",
  "icon": "car-battery",
  "license": "(c) EMerge Alliance 2025, Licensed CC BY-NC-ND 4.0 -All Rights Reserved",
  "description": "This schema may be used for any battery presenting two power terminals, with no associated electronics apart from a BMS",
  "fileVersion": "1.0",
  "fileDate":"2025-09-26",  
  "schema": {
    "type": "object",
    "properties": {
      "SOA": {"$ref": "SOA-schema.json#/schema"},
      "energyCapacity": {"description":"The energy capacity of the battery when new, as expressed by the manufacturer, either in Ah or Wh",
        "$ref": "energy-schema.json#/schema"},
      "meaasuredAtDischargeRate": {
        "title":"  ... when measured at a discharge rate of: ",
        "type": "string",
        "pattern": "^C[0-9]+(.[0-9]+)?$"
      },
      "typicalCycleLife": {"type": "number"},
      "minSOC":{
        "title":"..when discharged to this percentage: ",
        "type":"string",
        "pattern":"^[0-9][0-9]%$"
      },
      "chemistry": {"description":"Select the correct battery schema. (If your particular battery chemistry isn't offered, it is also possible to type a value in.)",
        "$ref": "chemistries-schema.json#/schema"},
      "mechanical":{"$ref":"mechanical-schema.json#/schema"},
      "terminalType":{"$ref":"connection-schema.json#/schema"},
      "BMSPort": {"$ref":"controlPort-schema.json#/schema"}
    },
    "required": [
      "energyCapacity",
      "chemistry"
    ]
  },
  "selectionTool": {
    "filter": [
      "chemistry",
      "nominalVoltage",
      "energyCapacity"
    ],
    "display": [
      "image",
      "chemistry",
      "nominalVoltage",
      "energyCapacity",
      "listPrice"
    ],
    "compare": [
      "chemistry",
      "nominalVoltage",
      "energyCapacity",
      "length",
      "width",
      "height",
      "weight",
      "listPrice"
    ]
  }
}
