  "$comment": "This schema may be used for any time measurement",
  "fileVersion": "1.1",
  "fileDate":"2026-02-12",  
  "schema": {
    "oneOf": [
       {
        "type": "string",
        "pattern": "^([0-9]+(.[0-9]+)?)(((n|µ|m)?s)|min|hrs|days|wks|mon|yrs)$"
      },
      {
        "type": "object",
        "properties": {
          "value": {"type": "number"},
          "units": {
            "type": "string",
            "enum": [
              "ns",
              "µs",
              "ms",
              "s",
              "mins",
              "hrs",
              "days",
              "wks",
              "yrs"
            ]
          }
        },
        "required": ["value","units"]
      }
    ]
  }
}
