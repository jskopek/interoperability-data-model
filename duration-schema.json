  "$comment": "This schema may be used for any time measurement",
  "fileVersion": "1.1",
  "fileDate":"2026-02-12",  
  "schema": {
    "oneOf": [
       {
        "type": "string",
        "pattern": "^([0-9]+(.[0-9]+)?)(((n|µ|m)?s)|min|hrs|days|wks|mon|yrs)$"
      },
      {
        "type": "object",
        "properties": {
          "value": {"type": "number"},
          "units": {
            "type": "string",
            "enum": [
              "ns",
              "µs",
              "ms",
              "s",
              "mins",
              "hrs",
              "days",
              "wks",
              "yrs"
            ]
          }
        },
        "required": ["value","units"]
      }
    ]
  },
    "dataEntry": {
    "prompt": "Units of time",
    "entryType": "dropdown",
    "dropdownValues": [
      ["ns","nanoseconds",1E-9],
      ["µs","microseconds",1E-6],
      ["ms","milliseconds",1E-3],
      ["s","secs","seconds",1],
      ["mins","minutes",60],
      ["hrs","hours",3600],
      ["days","days",86400],
      ["wks","weeks",604800],
      ["yrs","years",31557600]
    ]
}
