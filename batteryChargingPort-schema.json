  "fileVersion": "1.1",
  "fileDate":"2026-06-05",  
  "schema": {
    "$comment": "This schema is for a battery charging port",
    "type": "object",
    "properties": {
      "nominalVoltage": {
        "anyOf": [
          {"$ref": "voltageRating-schema.json#/schema"},
          {
            "type": "array",
            "items": {"$ref": "voltageRating-schema.json#/schema"}
          }
        ]
      },
      "minBattVolts": {"title":"Minimum permitted battery voltage",
         "$ref": "voltageRating-schema.json#/schema"},
      "maxBattVolts": {"title":"Maximum permitted battery voltage",
         "$ref": "voltageRating-schema.json#/schema"},
      "maxChargingCurrent":{"$ref":"currentRating-schema.json#/schema"},
      "outputPowerLimit":{"$ref":"powerRating-schema.json#/schema"},
      "chemistry": {
        "anyOf": [
          { "$ref": "chemistries-schema.json#/schema" },
          {
            "type": "array",
            "items": {
              "$ref": "chemistries-schema.json#/schema"
            }
          }
        ]
      },
      "BMSCommunication": {
        "type": "object",
        "properties": {
          "protocol": {
            "anyOf": [
              {"type": "string"},
              {
                "type": "array",
                "items": {"type": "string"}
              }
            ]
          },
          "interface": {
            "anyOf": [
              {"type": "string"},
              {
                "type": "array",
                "items": {"type": "string"}
              }
            ]
          }
        }
      }
    },
    "required": [
      "chemistry"
    ]
  }
}
